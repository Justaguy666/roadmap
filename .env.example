# ─────────────────────────────────────────────
# RoadmapAI — Environment Configuration Example
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
ROADMAP_ENV=development          # development | production
ROADMAP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
ROADMAP_DATA_DIR=~/.roadmap      # where DB and cache are stored

# ── Database ─────────────────────────────────
# SQLite (default for dev)
ROADMAP_DATABASE_URL=sqlite:///~/.roadmap/roadmap.db

# PostgreSQL (uncomment for production)
# ROADMAP_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/roadmap

# ── LLM Provider ──────────────────────────────
ROADMAP_LLM_PROVIDER=gemini      # gemini | openai | mock
GEMINI_API_KEY=AIzaSy...         # Google AI Studio API Key
GEMINI_MODEL=gemini-2.5-flash    # gemini-2.5-flash | gemini-2.5-pro

# OpenAI (alternative)
# ROADMAP_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

ROADMAP_LLM_TEMPERATURE=0.2
ROADMAP_LLM_MAX_TOKENS=4096
ROADMAP_LLM_MAX_RETRIES=3
ROADMAP_LLM_REQUESTS_PER_MINUTE=4.0

# ── LLM Application Budget & Quotas ───────────
ROADMAP_DAILY_LLM_BUDGET=15
ROADMAP_RESEARCH_LLM_BUDGET=5
ROADMAP_GENERATION_LLM_BUDGET=5
ROADMAP_EVALUATION_LLM_BUDGET=5
ROADMAP_LLM_BUDGET_WINDOW_HOURS=24
ROADMAP_LLM_PROVIDER_COOLDOWN_SECONDS=3600

# ── Search Provider (MVP-3) ──────────────────
ROADMAP_SEARCH_PROVIDER=exa      # exa | tavily | mock
ROADMAP_SEARCH_MAX_RESULTS=10
EXA_API_KEY=...

# ── Research Cache ───────────────────────────
ROADMAP_CACHE_TTL_HOURS=24       # how long to cache research results
ROADMAP_CACHE_MAX_SIZE_MB=512

# ── Agent Limits ─────────────────────────────
ROADMAP_AGENT_MAX_REVISIONS=3    # max planning loop iterations
ROADMAP_RESEARCH_TIMEOUT_SECONDS=120
